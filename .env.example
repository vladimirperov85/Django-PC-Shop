# Django/PC_Shop/.env.example
# Шаблон для создания .env на сервере (продакшен).
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env

# Обязательные
SECRET_KEY=сгенерируйте_новый_ключ_или_вставьте_свой
DEBUG=False
ALLOWED_HOSTS=IP-сервера,localhost,127.0.0.1

# PostgreSQL (на сервере)
DB_ENGINE=postgres
DB_NAME=shop_db
DB_USER=shop_user
DB_PASSWORD=пароль_пользователя_БД
DB_HOST=localhost
DB_PORT=5432

# HTTPS (пока выключено, активируется при домене)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
